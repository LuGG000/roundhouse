# Maintainer: LuGG000 <81622672+LuGG000@users.noreply.github.com>
pkgname=roundhouse-bin
pkgver=0.4.3
pkgrel=1
pkgdesc='Hub to start new Claude Code chats and return to old ones, in any folder (prebuilt binary)'
arch=('x86_64' 'aarch64')
url='https://github.com/LuGG000/roundhouse'
license=('Apache-2.0')
provides=('roundhouse')
conflicts=('roundhouse')
source_x86_64=("$url/releases/download/v$pkgver/roundhouse_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/roundhouse_${pkgver}_linux_arm64.tar.gz")
sha256sums_x86_64=('38c2c76b1c08d2370ae8cb19c77b700374b04d8ebcd41a2a00f4d46c9698e0f4')
sha256sums_aarch64=('ee79943caff40f0235e0006d202b4f2385494bc7d14847c314f82b2451385158')

package() {
  install -Dm755 roundhouse "$pkgdir/usr/bin/roundhouse"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  install -Dm644 THIRD_PARTY_NOTICES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
}
