# Maintainer: LuGG000 <81622672+LuGG000@users.noreply.github.com>
pkgname=roundhouse
pkgver=0.4.3
pkgrel=1
pkgdesc='Hub to start new Claude Code chats and return to old ones, in any folder'
arch=('x86_64' 'aarch64')
url='https://github.com/LuGG000/roundhouse'
license=('Apache-2.0')
makedepends=('go')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('a6fccdefae6dfe4dc4387b326fb1977e6948c34bf93b6de427033fd881d7574d')

build() {
  cd "$pkgname-$pkgver"
  export CGO_ENABLED=0 GOFLAGS='-trimpath -mod=readonly'
  go build -ldflags "-s -w -X main.version=$pkgver" -o "$pkgname" ./cmd/roundhouse
}

check() {
  cd "$pkgname-$pkgver"
  go test ./...
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  install -Dm644 THIRD_PARTY_NOTICES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
}
